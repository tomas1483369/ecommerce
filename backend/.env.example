# Copia este archivo a backend/.env y completa los valores. Lo valida src/lib/env.ts al arrancar.
PORT=3001
NODE_ENV=development

# Base de datos local de docker-compose (docker compose up -d db)
DATABASE_URL=postgresql://tecno:tecno@localhost:5432/tecnosoftware

FRONTEND_URL=http://localhost:5173

# Clerk (se elimina en la fase F5)
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=

# Polar (se reemplaza por Wompi en la fase F6)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_API_BASE=https://api.polar.sh
POLAR_CHECKOUT_PRODUCT_ID=00000000-0000-0000-0000-000000000000

# ImageKit
IMAGEKIT_PUBLIC_KEY=public_REPLACE_ME
IMAGEKIT_PRIVATE_KEY=private_REPLACE_ME
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID

# Opcional
SENTRY_DSN=

# Públicas: el backend no las usa; docker-compose las pasa al build del frontend
VITE_SENTRY_DSN=
VITE_WHATSAPP_NUMBER=573001234567
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_TIKTOK_URL=
