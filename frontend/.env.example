# Copia a frontend/.env.local para desarrollo con `npm run dev:frontend`.
# Solo valores PÚBLICOS: todo lo que empieza por VITE_ termina dentro del JavaScript del navegador.
VITE_API_URL=http://localhost:3001
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID
VITE_SENTRY_DSN=
# Número de WhatsApp de la tienda, con indicativo de país (57 = Colombia)
VITE_WHATSAPP_NUMBER=573001234567
# Redes sociales del footer (URL completa con https://). Las vacías no se muestran.
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_TIKTOK_URL=
